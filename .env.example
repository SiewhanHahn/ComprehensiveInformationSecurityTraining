# 复制为 .env 并填写本机随机值；不要把 .env 提交。
# 生成随机值示例：openssl rand -hex 32

# MySQL
MYSQL_ROOT_PASSWORD=replace-with-long-random-root
MYSQL_APP_PASSWORD=replace-with-long-random-app

# 应用密钥
APP_SECRET_KEY=replace-with-long-random-value

# 演示账号密码（seed 时创建；不写死默认密码）
DEMO_ADMIN_PASSWORD=replace-with-admin-password
DEMO_ANALYST_PASSWORD=replace-with-analyst-password
DEMO_REVIEWER_PASSWORD=replace-with-reviewer-password
DEMO_VIEWER_PASSWORD=replace-with-viewer-password
